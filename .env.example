# NomadsAI Environment Configuration
# Copy this file to .env in backend/ directory for local development

# =============================================================================
# BACKEND CONFIGURATION (backend/.env)
# =============================================================================

# NVIDIA AI Integration (Optional - for AI-powered generation)
# If not set, system will use high-quality standalone pipeline
NVIDIA_API_KEY=your_nvidia_api_key_here

# CORS Configuration (Optional - defaults to allow all origins)
# For production, set to your frontend domain
CORS_ORIGINS=https://your-frontend.vercel.app

# Logging Configuration (Optional)
LOG_LEVEL=INFO

# =============================================================================
# FRONTEND CONFIGURATION (frontend/.env.local)
# =============================================================================

# Backend API Base URL
# For local development
NEXT_PUBLIC_API_BASE=http://localhost:8000

# For production (Vercel deployment)
# NEXT_PUBLIC_API_BASE=https://your-backend.onrender.com

# =============================================================================
# DEPLOYMENT NOTES
# =============================================================================

# Vercel (Frontend):
# - Set NEXT_PUBLIC_API_BASE to your Render backend URL
# - Automatic deployment on push to main branch

# Render (Backend):
# - Set NVIDIA_API_KEY if you want AI-powered generation
# - Set CORS_ORIGINS to your Vercel frontend URL
# - Automatic deployment on push to main branch

# System works perfectly without NVIDIA_API_KEY using standalone pipeline
# No other environment variables are required for basic operation