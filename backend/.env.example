# NomadAI Environment Configuration

# AI PROVIDERS (Priority Order: Groq > DeepSeek > Together.ai > NVIDIA NIM)

# Groq (Primary - Recommended - Fast & Free)
# Get free API key: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# DeepSeek (Fallback 1 - Recommended - Capable & Free)
# Get free API key: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# Together.ai (Optional Fallback 2)
# Get free API key: https://api.together.xyz/settings/api-keys
TOGETHER_API_KEY=your_together_ai_api_key_here

# NVIDIA NIM (Optional Fallback 3)
# Get API key: https://build.nvidia.com/
NVIDIA_API_KEY=your_nvidia_api_key_here

# CORS Configuration
CORS_ORIGINS=https://your-frontend.vercel.app,http://localhost:3000

# MINIMUM REQUIRED: Set at least GROQ_API_KEY or DEEPSEEK_API_KEY for full AI features
# Without any API keys, the system will use basic template fallback (limited functionality)
